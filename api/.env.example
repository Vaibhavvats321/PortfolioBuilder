# Copy to api/.env and adjust for your environment.
# SQLAlchemy database URL using the psycopg (v3) driver.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/portfolio_builder

# development | test | staging | production
ENVIRONMENT=development

# Enable debug behavior (never enable in production)
DEBUG=false

# Comma-separated list of allowed browser origins.
# Wildcards are rejected because credentialed requests are enabled.
CORS_ORIGINS=http://localhost:3000

# Session/CSRF cookie configuration (optional; sensible defaults apply).
# Session lifetime in minutes (default: 10080 = 7 days).
SESSION_TTL_MINUTES=10080
# Names of the authentication cookies. The CSRF cookie must match the
# frontend's CSRF cookie name (see web/src/lib/api/client.ts).
SESSION_COOKIE_NAME=pb_session
CSRF_COOKIE_NAME=pb_csrf
# Force the Secure cookie flag. Defaults to true for staging/production and
# false for development (local http). Set explicitly to override.
# COOKIE_SECURE=true

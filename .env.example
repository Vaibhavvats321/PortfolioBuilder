# ---------------------------------------------------------------------------
# Portfolio Builder - environment variable reference
#
# Copy the relevant block into the environment file used by the app:
#   - Backend:  api/.env      (loaded by pydantic-settings)
#   - Frontend: web/.env.local (loaded by Next.js)
#
# These are placeholders only. Never commit real credentials or secrets.
# ---------------------------------------------------------------------------

# ------------------------------ Backend (api/.env) -------------------------
# SQLAlchemy database URL. The driver is psycopg (SQLAlchemy 3 driver).
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/portfolio_builder

# Application environment: development | test | staging | production
ENVIRONMENT=development

# Enable debug behavior (never enable in production)
DEBUG=false

# Comma-separated list of allowed browser origins for CORS.
# Wildcards are rejected because credentialed requests are enabled.
CORS_ORIGINS=http://localhost:3000

# --- Authentication cookies (optional; defaults shown) ---
# Session lifetime in minutes (default: 10080 = 7 days).
SESSION_TTL_MINUTES=10080
SESSION_COOKIE_NAME=pb_session
CSRF_COOKIE_NAME=pb_csrf
# Force the Secure cookie flag. Defaults to true for staging/production and
# false for development (local http). Set explicitly to override.
# COOKIE_SECURE=true

# ------------------------------ Frontend (web/.env.local) ------------------
# Base URL of the FastAPI backend used for client-side API calls.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
